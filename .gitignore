# dipendenze e build
node_modules/
dist/

# generato da scripts/scan-images.mjs prima di ogni dev/build
src/gallery-images.generated.js

# ambiente / editor / os
.DS_Store
*.local
*.log
.vscode/
.idea/

# materiale di riferimento del sito originale (recording, screenshot,
# dati CMS estratti): non va pubblicato in nessun caso
reference/

# originali a piena risoluzione delle foto: lo scan riscrive public/img sul posto
_originals/

# vecchia cartella dei media: fuori da public/ per non finire nel deploy
_unused/

# Di public/ vengono pubblicate SOLO img2/ e dab/. Tutto il resto della
# cartella finisce comunque in dist/ (vite ci copia dentro public/ per intero),
# quindi scarti e file parcheggiati qui andrebbero online: al momento sarebbero
# ~27 MB, HEIC compresi, che nessun browser sa mostrare.
public/*
!public/img2/
!public/dab/
